st_details":{"upstream_inference_cost":0.016866,"upstream_inference_prompt_cost":0.012076,"upstream_inference_completions_cost":0.00479},"completion_tokens_details":{"reasoning_tokens":0,"image_tokens":0,"audio_tokens":0}}}