e,"prompt_tokens_details":{"cached_tokens":7279,"cache_write_tokens":0,"audio_tokens":0,"video_tokens":0},"cost_details":{"upstream_inference_cost":0.02039695,"upstream_inference_prompt_cost":0.00036695,"upstream_inference_completions_cost":0.02003},"completion_tokens_details":{"reasoning_tokens":52,"image_tokens":0,"audio_tokens":0}}}