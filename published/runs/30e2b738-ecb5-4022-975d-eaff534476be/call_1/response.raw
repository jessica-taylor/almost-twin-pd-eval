NsYXVkZS1vcHVzLTUuNS0yMDI2MDkyMXxhbnRocm9waWMifQ"}]}}],"usage":{"prompt_tokens":10036,"completion_tokens":461,"total_tokens":10497,"cost":0.049364,"is_byok":false,"prompt_tokens_details":{"cached_tokens":0,"cache_write_tokens":0,"audio_tokens":0,"video_tokens":0},"cost_details":{"upstream_inference_cost":0.049364,"upstream_inference_prompt_cost":0.040144,"upstream_inference_completions_cost":0.00922},"completion_tokens_details":{"reasoning_tokens":87,"image_tokens":0,"audio_tokens":0}}}