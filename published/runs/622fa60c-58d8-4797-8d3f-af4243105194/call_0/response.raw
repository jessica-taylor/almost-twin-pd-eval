534,"total_tokens":7228,"cost":0.018728,"is_byok":false,"prompt_tokens_details":{"cached_tokens":0,"cache_write_tokens":0,"audio_tokens":0,"video_tokens":0},"cost_details":{"upstream_inference_cost":0.018728,"upstream_inference_prompt_cost":0.013388,"upstream_inference_completions_cost":0.00534},"completion_tokens_details":{"reasoning_tokens":0,"image_tokens":0,"audio_tokens":0}}}