bmRwb2ludF9zbHVnIjoiYW50aHJvcGljL2NsYXVkZS1vcHVzLTUuNS0yMDI2MDkyMXxhbnRocm9waWMifQ"}]}}],"usage":{"prompt_tokens":10095,"completion_tokens":394,"total_tokens":10489,"cost":0.04826,"is_byok":false,"prompt_tokens_details":{"cached_tokens":0,"cache_write_tokens":0,"audio_tokens":0,"video_tokens":0},"cost_details":{"upstream_inference_cost":0.04826,"upstream_inference_prompt_cost":0.04038,"upstream_inference_completions_cost":0.00788},"completion_tokens_details":{"reasoning_tokens":112,"image_tokens":0,"audio_tokens":0}}}