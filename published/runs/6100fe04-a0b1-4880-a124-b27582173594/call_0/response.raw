ost_details":{"upstream_inference_cost":0.01665,"upstream_inference_prompt_cost":0.01184,"upstream_inference_completions_cost":0.00481},"completion_tokens_details":{"reasoning_tokens":0,"image_tokens":0,"audio_tokens":0}}}