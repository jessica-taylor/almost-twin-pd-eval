qnCHZsjHbuKRKB4ybXCeJBXA7Wh0PKvTSOQ2E4spByBLm3t1IZiSYpxwW0ffALEiKsf9SYXeE-SEN8fnvfIijecCRj4AZAj-JF9NCVnlhigmBYtbdBjVg==.eyJlbmRwb2ludF9zbHVnIjoib3BlbmFpL2dwdC02LjEtdGVycmEtMjAyNjEwMjZ8b3BlbmFpIn0","format":"openai-responses-v1","id":"rs_0fef56f90b6f4533016af0fe98220c87d19a6c25074a2ea5cc","index":0}]}}],"usage":{"prompt_tokens":7282,"completion_tokens":4497,"total_tokens":11779,"cost":0.02285195,"is_byok":false,"prompt_tokens_details":{"cached_tokens":7279,"cache_write_tokens":0,"audio_tokens":0,"video_tokens":0},"cost_details":{"upstream_inference_cost":0.02285195,"upstream_inference_prompt_cost":0.00036695,"upstream_inference_completions_cost":0.022485},"completion_tokens_details":{"reasoning_tokens":45,"image_tokens":0,"audio_tokens":0}}}