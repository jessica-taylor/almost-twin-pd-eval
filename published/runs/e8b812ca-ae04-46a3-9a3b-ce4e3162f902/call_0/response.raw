st_details":{"upstream_inference_cost":0.0260387,"upstream_inference_prompt_cost":0.0028337,"upstream_inference_completions_cost":0.023205},"completion_tokens_details":{"reasoning_tokens":67,"image_tokens":0,"audio_tokens":0}}}