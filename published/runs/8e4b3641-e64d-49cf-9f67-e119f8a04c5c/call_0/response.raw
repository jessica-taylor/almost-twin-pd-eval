pt_tokens_details":{"cached_tokens":0,"cache_write_tokens":0,"audio_tokens":0,"video_tokens":0},"cost_details":{"upstream_inference_cost":0.047592,"upstream_inference_prompt_cost":0.039872,"upstream_inference_completions_cost":0.00772},"completion_tokens_details":{"reasoning_tokens":71,"image_tokens":0,"audio_tokens":0}}}