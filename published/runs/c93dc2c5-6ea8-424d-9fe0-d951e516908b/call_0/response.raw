_tokens":0},"cost_details":{"upstream_inference_cost":0.017854,"upstream_inference_prompt_cost":0.012904,"upstream_inference_completions_cost":0.00495},"completion_tokens_details":{"reasoning_tokens":0,"image_tokens":0,"audio_tokens":0}}}