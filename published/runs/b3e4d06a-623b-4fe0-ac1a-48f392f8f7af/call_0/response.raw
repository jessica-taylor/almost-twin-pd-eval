tokens":6075,"completion_tokens":523,"total_tokens":6598,"cost":0.01738,"is_byok":false,"prompt_tokens_details":{"cached_tokens":0,"cache_write_tokens":0,"audio_tokens":0,"video_tokens":0},"cost_details":{"upstream_inference_cost":0.01738,"upstream_inference_prompt_cost":0.01215,"upstream_inference_completions_cost":0.00523},"completion_tokens_details":{"reasoning_tokens":0,"image_tokens":0,"audio_tokens":0}}}