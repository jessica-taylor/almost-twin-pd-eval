Qgml__68qG1zqIog-ksnEZP2xUJUQwcZblK_WKoYWZTzPV31Vwv25iR_hO3dHhiwAQZLjKLc7TSPmlEfyO_y7eHdoLyGd0oNjwSOfz3x1sOAdHtqs6hVVq7KUIFlzFj8SF7-lRcVmffsHQYfuKJd5loWi8n2b4AlCX6NdUatC1wEM-c5TrCzzNpVzofca9EF2O0ZqHFY5RqVcVH3nY50A65UxdkT_707xsmIj6mQYTNbbS-ooqfkff1PJqQr1aDdBgeYTLSwKleGp1j0HdJ4_r6wAa5_AVKrNqBUFnUc0XvBE2g0KZ86KWE9JfEWAyfpSq4Br5dHJgoBIFPT5kdlFj2Ws9Jer7dzsz6kLMAOJSEONiv4FGNf9gqHwADktofFxNBFaQh7pxcoH5dDUWdOgu4Kjuc-68ohr8-R5QHy1ci1AcMVfZE7E1SW7krvgehGPELSrHkFoUNKeb_cahhyRKtA6JOmbEUjmY38aT6CpYcZ-Q-SBSMSD0W-6b2sq56axqSHEvSUiFvNTu2tZ2A9Eg_ee-Ukr4VerXf3ReBU89S2mnfkVpwd0wbP5jNbt7jUZ1Msmj7GIqY5J8=.eyJlbmRwb2ludF9zbHVnIjoib3BlbmFpL2dwdC02LjEtdGVycmEtMjAyNjEwMjZ8b3BlbmFpIn0","format":"openai-responses-v1","id":"rs_027084bd61107aef016af0ee3f6b2887d1bbe93440d70c85e8","index":0}]}}],"usage":{"prompt_tokens":7282,"completion_tokens":4210,"total_tokens":11492,"cost":0.02141695,"is_byok":false,"prompt_tokens_details":{"cached_tokens":7279,"cache_write_tokens":0,"audio_tokens":0,"video_tokens":0},"cost_details":{"upstream_inference_cost":0.02141695,"upstream_inference_prompt_cost":0.00036695,"upstream_inference_completions_cost":0.02105},"completion_tokens_details":{"reasoning_tokens":61,"image_tokens":0,"audio_tokens":0}}}