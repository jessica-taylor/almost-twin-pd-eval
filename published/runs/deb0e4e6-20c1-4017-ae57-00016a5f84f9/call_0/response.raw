rsus 4, and I'm going with that.\n\n","format":"anthropic-claude-v1","index":0,"signature":".eyJlbmRwb2ludF9zbHVnIjoiYW50aHJvcGljL2NsYXVkZS1vcHVzLTUuNS0yMDI2MDkyMXxhbnRocm9waWMifQ"}]}}],"usage":{"prompt_tokens":9566,"completion_tokens":404,"total_tokens":9970,"cost":0.046344,"is_byok":false,"prompt_tokens_details":{"cached_tokens":0,"cache_write_tokens":0,"audio_tokens":0,"video_tokens":0},"cost_details":{"upstream_inference_cost":0.046344,"upstream_inference_prompt_cost":0.038264,"upstream_inference_completions_cost":0.00808},"completion_tokens_details":{"reasoning_tokens":72,"image_tokens":0,"audio_tokens":0}}}