o_tokens":0},"cost_details":{"upstream_inference_cost":0.019218,"upstream_inference_prompt_cost":0.014518,"upstream_inference_completions_cost":0.0047},"completion_tokens_details":{"reasoning_tokens":0,"image_tokens":0,"audio_tokens":0}}}