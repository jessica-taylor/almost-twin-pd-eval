nction.\n\nSo I stay quiet.\n\npass","refusal":null,"reasoning":null}}],"usage":{"prompt_tokens":6770,"completion_tokens":557,"total_tokens":7327,"cost":0.01911,"is_byok":false,"prompt_tokens_details":{"cached_tokens":0,"cache_write_tokens":0,"audio_tokens":0,"video_tokens":0},"cost_details":{"upstream_inference_cost":0.01911,"upstream_inference_prompt_cost":0.01354,"upstream_inference_completions_cost":0.00557},"completion_tokens_details":{"reasoning_tokens":0,"image_tokens":0,"audio_tokens":0}}}