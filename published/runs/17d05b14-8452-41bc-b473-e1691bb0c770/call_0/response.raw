}],"usage":{"prompt_tokens":6235,"completion_tokens":532,"total_tokens":6767,"cost":0.01779,"is_byok":false,"prompt_tokens_details":{"cached_tokens":0,"cache_write_tokens":0,"audio_tokens":0,"video_tokens":0},"cost_details":{"upstream_inference_cost":0.01779,"upstream_inference_prompt_cost":0.01247,"upstream_inference_completions_cost":0.00532},"completion_tokens_details":{"reasoning_tokens":0,"image_tokens":0,"audio_tokens":0}}}