o_tokens":0},"cost_details":{"upstream_inference_cost":0.016934,"upstream_inference_prompt_cost":0.012264,"upstream_inference_completions_cost":0.00467},"completion_tokens_details":{"reasoning_tokens":0,"image_tokens":0,"audio_tokens":0}}}