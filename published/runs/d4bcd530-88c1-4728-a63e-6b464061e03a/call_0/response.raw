":7359,"completion_tokens":537,"total_tokens":7896,"cost":0.020088,"is_byok":false,"prompt_tokens_details":{"cached_tokens":0,"cache_write_tokens":0,"audio_tokens":0,"video_tokens":0},"cost_details":{"upstream_inference_cost":0.020088,"upstream_inference_prompt_cost":0.014718,"upstream_inference_completions_cost":0.00537},"completion_tokens_details":{"reasoning_tokens":0,"image_tokens":0,"audio_tokens":0}}}